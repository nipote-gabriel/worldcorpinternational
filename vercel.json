{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/portfolio", "destination": "/centres", "permanent": true },
    { "source": "/partnerships", "destination": "/about#partners", "permanent": true },
    { "source": "/more", "destination": "/stories", "permanent": true },
    { "source": "/get-in-touch", "destination": "/join#contact", "permanent": true },
    { "source": "/sponsorship-deck", "destination": "/join", "permanent": true },
    { "source": "/brands", "destination": "/join", "permanent": true },
    { "source": "/shop", "destination": "/", "permanent": true },
    { "source": "/live-shows", "destination": "/events", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
